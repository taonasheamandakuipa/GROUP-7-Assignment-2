            "name": "KMeansDiagnostics",
            "mode": "import",
            "source": {
              "type": "m",
              "expression": [
                "let",
                "    Source = Csv.Document(File.Contents(DataFolder & \"pbi_kmeans_diagnostics.csv\"), [Delimiter = \",\", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]),",
                "    Promoted = Table.PromoteHeaders(Source, [PromoteAllScalars = true]),",
                "    Blanks = Table.TransformColumns(Promoted, {}, (x) => if x = \"\" then null else x),",
                "    Typed = Table.TransformColumnTypes(Blanks, {{\"k\", Int64.Type}, {\"WCSS\", type number}, {\"mean_silhouette\", type number}, {\"pct_reduction_from_previous_k\", type number}}, \"en-US\")",
                "in",
                "    Typed"
              ]
            }
          }
        ]
      },
      {
        "name": "Reconciliation",
        "columns": [
          {
            "name": "figure",
            "dataType": "string",
            "sourceColumn": "figure",
            "summarizeBy": "none"
          },
          {
            "name": "python_value",
            "dataType": "double",
            "sourceColumn": "python_value",
            "summarizeBy": "sum",
            "formatString": "#,0"
          }
        ],
        "partitions": [
          {
            "name": "Reconciliation",
            "mode": "import",
            "source": {
              "type": "m",
              "expression": [
                "let",
                "    Source = Csv.Document(File.Contents(DataFolder & \"pbi_reconciliation_targets.csv\"), [Delimiter = \",\", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]),",
                "    Promoted = Table.PromoteHeaders(Source, [PromoteAllScalars = true]),",
                "    Blanks = Table.TransformColumns(Promoted, {}, (x) => if x = \"\" then null else x),",
                "    Typed = Table.TransformColumnTypes(Blanks, {{\"figure\", type text}, {\"python_value\", type number}}, \"en-US\")",
                "in",
                "    Typed"
              ]
            }
          }
        ]
      },
      {
        "name": "KeyMeasures",
        "columns": [
          {
            "name": "Column",
            "dataType": "string",
            "sourceColumn": "Column",
            "isHidden": true
          }
        ],
        "partitions": [
          {
            "name": "KeyMeasures",
            "mode": "import",
            "source": {
              "type": "m",
              "expression": [
                "let",
                "    Source = #table(type table [Column = text], {{\"x\"}})",
                "in",
                "    Source"
              ]
            }
          }
        ],
        "measures": [
          {
            "name": "Population 2025",
            "expression": "SUM(DistrictProfiles[population_2025])",
            "formatString": "#,0"
          },
          {
            "name": "Population 2026 reported",
            "expression": "SUM(DistrictProfiles[population_2026])",
            "formatString": "#,0"
          },
          {
            "name": "Population 2026 reconstructed",
            "expression": "SUM(DistrictProfiles[reconstructed_2026])",
            "formatString": "#,0"
          },
          {
            "name": "Balance gap",
            "expression": "[Population 2026 reported] - [Population 2026 reconstructed]",
            "formatString": "#,0"
          },
          {
            "name": "Mid-year exposure 2025",
            "expression": "([Population 2025] + [Population 2026 reported]) / 2",
            "formatString": "#,0.0"
          },
          {
            "name": "CBR per 1000",
            "expression": "DIVIDE(SUM(DistrictProfiles[births_2025]) * 1000, [Mid-year exposure 2025])",
            "formatString": "0.00"
          },
          {
            "name": "CDR per 1000",
            "expression": "DIVIDE(SUM(DistrictProfiles[deaths_2025]) * 1000, [Mid-year exposure 2025])",
            "formatString": "0.00"
          },
          {
            "name": "NMR per 1000",
            "expression": "DIVIDE((SUM(DistrictProfiles[arrivals_2025]) - SUM(DistrictProfiles[departures_2025])) * 1000, [Mid-year exposure 2025])",
            "formatString": "0.00"
          },
          {
            "name": "Districts",
            "expression": "DISTINCTCOUNT(DistrictProfiles[district_id])",
            "formatString": "0"
          },
          {
            "name": "Males (left)",
            "expression": "CALCULATE(SUM(AgeSex2025[population_2025]), AgeSex2025[sex] = \"M\") * -1",
            "formatString": "#,0;#,0"
          },
          {
            "name": "Females (right)",
            "expression": "CALCULATE(SUM(AgeSex2025[population_2025]), AgeSex2025[sex] = \"F\")",
            "formatString": "#,0"
          },
          {
            "name": "Share under 15 % (2025)",
            "expression": "DIVIDE(CALCULATE(SUM(AgeSex2025[population_2025]), AgeSex2025[age_start] < 15), SUM(AgeSex2025[population_2025])) * 100",
            "formatString": "0.0"
          },
          {
            "name": "Share 65+ % (2025)",
            "expression": "DIVIDE(CALCULATE(SUM(AgeSex2025[population_2025]), AgeSex2025[age_start] >= 65), SUM(AgeSex2025[population_2025])) * 100",
            "formatString": "0.0"
          },
          {
            "name": "Projected population 2030",
            "expression": "SUM(ProjectionAgeSex[pop_2030])",
            "formatString": "#,0"
          },
          {
            "name": "Population 2025 (projection base)",
            "expression": "SUM(ProjectionAgeSex[pop_2025])",
            "formatString": "#,0"
          },
          {
            "name": "Projected ages 0-4",
            "expression": "CALCULATE([Projected population 2030], ProjectionAgeSex[age_start] = 0)",
            "formatString": "#,0"
          },
          {
            "name": "Projected share under 15 %",
            "expression": "DIVIDE(CALCULATE([Projected population 2030], ProjectionAgeSex[age_start] < 15), [Projected population 2030]) * 100",
            "formatString": "0.0"
          },
          {
            "name": "Projected share 65+ %",
            "expression": "DIVIDE(CALCULATE([Projected population 2030], ProjectionAgeSex[age_start] >= 65), [Projected population 2030]) * 100",
            "formatString": "0.0"
          },
          {
            "name": "Net migration 5 yr",
            "expression": "SUM(ProjectionAgeSex[net_migration_5yr])",
            "formatString": "#,0"
          },
          {
            "name": "Expected lives",
            "expression": "SUM(MarkovOccupancy[expected_lives])",
            "formatString": "#,0.0"
          },
          {
            "name": "Expected deaths",
            "expression": "SUM(ExpectedClaims[expected_deaths])",
            "formatString": "#,0.0"
          },
          {
            "name": "Expected benefits USD",
            "expression": "SUM(ExpectedClaims[expected_benefits_usd])",
            "formatString": "\\$#,0"
          },
          {
            "name": "Benefits year 1 USD",
            "expression": "CALCULATE([Expected benefits USD], ExpectedClaims[policy_year] = 1)",
            "formatString": "\\$#,0"
          },
          {
            "name": "Benefits year 2 USD",
            "expression": "CALCULATE([Expected benefits USD], ExpectedClaims[policy_year] = 2)",
            "formatString": "\\$#,0"
          },
          {
            "name": "Insured lives at start",
            "expression": "CALCULATE([Expected lives], MarkovOccupancy[t_years] = 0)",
            "formatString": "#,0"
          },
          {
            "name": "Transition probability",
            "expression": "SUM(TransitionMatrices[probability])",
            "formatString": "0.0000"
          },
          {
            "name": "Python value",
            "expression": "SUM(Reconciliation[python_value])",
            "formatString": "#,0"
          },
          {
            "name": "Dashboard value",
            "expression": "VAR f = SELECTEDVALUE(Reconciliation[figure])\nRETURN SWITCH(TRUE(),\n    CONTAINSSTRING(f, \"Total population\"), CALCULATE([Population 2025], REMOVEFILTERS(DistrictProfiles)),\n    CONTAINSSTRING(f, \"cohort-component Base\"), CALCULATE([Projected population 2030], ProjectionAgeSex[scenario] = \"Base\", REMOVEFILTERS(ProjectionAgeSex)),\n    CONTAINSSTRING(f, \"year 1\"), CALCULATE([Benefits year 1 USD], REMOVEFILTERS(DistrictProfiles), REMOVEFILTERS(ExpectedClaims)),\n    CONTAINSSTRING(f, \"year 2\"), CALCULATE([Benefits year 2 USD], REMOVEFILTERS(DistrictProfiles), REMOVEFILTERS(ExpectedClaims)),\n    CONTAINSSTRING(f, \"cluster\"), CALCULATE(COUNTROWS(DistrictProfiles), DistrictProfiles[cluster_name] = \"Ageing, natural decrease\", REMOVEFILTERS(DistrictProfiles)),\n    BLANK())",
            "formatString": "#,0"
          },
          {
            "name": "Difference (dashboard - Python)",
            "expression": "ROUND([Dashboard value] - [Python value], 2)",
            "formatString": "0.00"
          },
          {
            "name": "Reconciled",
            "expression": "IF(ABS([Dashboard value] - [Python value]) < 0.5, \"Matches\", \"Check\")"
          },
          {
            "name": "Data note",
            "expression": "\"All figures are hypothetical (synthetic HASTS206 teaching data).\""
          }
        ]
      }
    ],
    "relationships": [
      {
        "name": "rel_AgeSex2025_district",
        "fromTable": "AgeSex2025",
        "fromColumn": "district_id",
        "toTable": "DistrictProfiles",
        "toColumn": "district_id"
      },
      {
        "name": "rel_MarkovOccupancy_district",
        "fromTable": "MarkovOccupancy",
        "fromColumn": "district_id",
        "toTable": "DistrictProfiles",
        "toColumn": "district_id"
      },
      {
        "name": "rel_ExpectedClaims_district",
        "fromTable": "ExpectedClaims",
        "fromColumn": "district_id",
        "toTable": "DistrictProfiles",
        "toColumn": "district_id"
      }
    ],
    "annotations": [
      {
        "name": "PBI_QueryOrder",
        "value": "[\"DataFolder\", \"DistrictProfiles\", \"AgeSex2025\", \"ProjectionAgeSex\", \"ProjectionMethods\", \"MarkovOccupancy\", \"ExpectedClaims\", \"TransitionMatrices\", \"ClusterCentroids\", \"KMeansDiagnostics\", \"Reconciliation\", \"KeyMeasures\"]"
      },
      {
        "name": "__PBI_TimeIntelligenceEnabled",
        "value": "0"
      },
      {
        "name": "PBIDesktopVersion",
        "value": "2.159.1231.0"
      }
    ]
  }
}