                "    Typed = Table.TransformColumnTypes(Blanks, {{\"district_id\", type text}, {\"district_name\", type text}, {\"region\", type text}, {\"population_2020\", Int64.Type}, {\"population_2025\", Int64.Type}, {\"population_2026\", Int64.Type}, {\"births_2025\", Int64.Type}, {\"deaths_2025\", Int64.Type}, {\"arrivals_2025\", Int64.Type}, {\"departures_2025\", Int64.Type}, {\"reconstructed_2026\", Int64.Type}, {\"CBR_per_1000\", type number}, {\"CDR_per_1000\", type number}, {\"RNI_per_1000\", type number}, {\"NMR_per_1000\", type number}, {\"growth_rate_per_1000\", type number}, {\"share_u15_pct\", type number}, {\"share_65plus_pct\", type number}, {\"piped_water_raw\", type number}, {\"piped_water_used_pct\", type number}, {\"piped_water_imputed_flag\", Int64.Type}, {\"cluster\", Int64.Type}, {\"cluster_name\", type text}, {\"selected_for_comparison\", Int64.Type}, {\"projection_district\", Int64.Type}}, \"en-US\")",
